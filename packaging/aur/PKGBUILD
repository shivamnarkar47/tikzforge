# Maintainer: TikzForge contributors
pkgname=tikzforge
pkgver=0.4.0
pkgrel=1
pkgdesc='Native TikZ/LaTeX editor with live PDF preview'
arch=('x86_64')
url='https://github.com/shivamnarkar47/tikzforge'
license=('MIT')
depends=('gtk3' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland' 'hicolor-icon-theme' 'tectonic')
makedepends=('rust' 'clang' 'pkgconf' 'curl')
install="$pkgname.install"
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/shivamnarkar47/tikzforge/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('843d5850f9133b1a96edfe428f6154bdfbbb7c0c9b799383adc2a83fce721f62')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p tikzforge-gpui
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/tikzforge-gpui "$pkgdir/usr/bin/tikzforge"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 legacy/src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/tikzforge.png"
  install -Dm644 legacy/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/tikzforge.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/tikzforge.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=TikzForge
Comment=Edit TikZ diagrams with live preview
Exec=tikzforge %f
Icon=tikzforge
Terminal=false
Categories=Development;Graphics;
MimeType=text/x-tex;
EOF
}
