{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tikzforge",
  "version": "0.2.1",
  "identifier": "com.vagabond.tikzforge",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tikzforge",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NUI5MzFFMTU4Mzc0QTcKUldTbmRJTVZIcE5iT1pOZUxHSTlhNHJMSHNqVUo5RVJ6eTJqZXFIdlM1VzVIU0s3Z0l2d2FTcGIK",
      "endpoints": [
        "https://github.com/shivamnarkar47/tikzforge/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["tectonic/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
